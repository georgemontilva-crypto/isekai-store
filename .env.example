# ═══════════════════════════════════════════════════════════════════════════════
# ISEKAI WORLD — Variables de entorno
# Copia este archivo como .env para desarrollo local.
# En Railway, agrega cada variable desde el dashboard del servicio.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Core ──────────────────────────────────────────────────────────────────────
# Cadena aleatoria larga para firmar las cookies de sesión JWT
# Genera una en: https://1password.com/password-generator/ (32+ chars)
JWT_SECRET=cambia_esto_por_un_secreto_seguro_de_al_menos_32_caracteres

# URL completa de tu base de datos MySQL en Railway
# Railway la provee automáticamente si agregas el plugin MySQL
DATABASE_URL=mysql://user:password@host:port/dbname

# URL pública de tu app en Railway (sin slash final)
# Ej: https://isekai-world-production.up.railway.app
APP_URL=https://tu-app.up.railway.app


# ── Auth: Google OAuth2 ───────────────────────────────────────────────────────
# 1. Ve a https://console.cloud.google.com
# 2. Crea un proyecto → APIs & Services → Credentials → Create OAuth 2.0 Client
# 3. Tipo: Web application
# 4. Authorized redirect URIs: https://tu-app.up.railway.app/api/auth/google/callback
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-tu_client_secret

# ── Auth: Admin ───────────────────────────────────────────────────────────────
# El email que se registre con esta dirección quedará con rol "admin" automáticamente
OWNER_EMAIL=isekaigroupca@gmail.com


# ── Email: Resend ─────────────────────────────────────────────────────────────
# 1. Crea cuenta en https://resend.com
# 2. API Keys → Create API Key
# 3. Domains → agrega y verifica tu dominio
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Dirección de envío (debe estar verificada en Resend)
RESEND_FROM=ISEKAI WORLD <noreply@isekaiworld.co>


# ── Storage: Cloudflare R2 ────────────────────────────────────────────────────
# 1. Ve a https://dash.cloudflare.com → R2 Object Storage → Create bucket
# 2. Nombra el bucket (ej: isekai-media) y configúralo como público
# 3. Manage R2 API Tokens → Create Token (Object Read & Write)
# 4. El Account ID está en la página principal de R2

R2_ACCOUNT_ID=tu_account_id_de_cloudflare
R2_ACCESS_KEY_ID=tu_r2_access_key_id
R2_SECRET_ACCESS_KEY=tu_r2_secret_access_key
R2_BUCKET_NAME=isekai-media

# URL pública del bucket R2 (se ve en Settings del bucket)
# Ej: https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
# O tu dominio personalizado si lo configuraste
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev


# ── Leads: Mailchimp ──────────────────────────────────────────────────────────
# 1. Mailchimp → Account → Extras → API Keys → Create A Key
# 2. Audience → Audience dashboard → Settings → Audience name and defaults
#    → Audience ID (es el List ID)
# 3. El Data Center son las últimas letras de tu API key (ej: "us21")
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21
MAILCHIMP_LIST_ID=abc123def4
MAILCHIMP_DC=us21


# ── Pagos ─────────────────────────────────────────────────────────────────────
# La tienda cobra en DÓLARES (USD) por Pago Móvil y Cripto (USDT / Tron TRC20).
# Ambos métodos son manuales con carga de comprobante: NO requieren variables
# de entorno. Los datos de cobro (CI, banco, teléfono, wallet) se editan en:
#   shared/payment.ts


# ── Solo para desarrollo local ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Antispam: Cloudflare Turnstile (OPCIONAL) ─────────────────────────────────
# El antispam YA funciona sin esto: campo trampa, tiempo mínimo y límite por IP.
# Estas dos variables activan una capa extra de verificación.
# 1. https://dash.cloudflare.com → Turnstile → Add site
# 2. Copia las dos claves aquí
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
